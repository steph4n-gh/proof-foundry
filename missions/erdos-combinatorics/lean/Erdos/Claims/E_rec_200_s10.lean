private theorem witness_sidon : Erdos.IsSidon witness := by
  unfold Erdos.IsSidon witness
  decide +kernel

private theorem certs_ok :
    ∀ k : Fin 200,
      let x := k.val + 1
      let t := certs.get k
      let a := t.1; let b := t.2.1; let c := t.2.2.1; let d := t.2.2.2
      x ∈ witness ∨
        (a ∈ x :: witness ∧ b ∈ x :: witness ∧ c ∈ x :: witness ∧ d ∈ x :: witness ∧
         a ≤ b ∧ c ≤ d ∧ a + b = c + d ∧ ¬ (a = c ∧ b = d)) := by
  decide +kernel

theorem record : Erdos.Statements.E_rec_200.Record 10 := by
  refine ⟨witness, by decide, by decide, by unfold Erdos.SubsetOfRange witness; decide, witness_sidon, ?_⟩
  intro x hx1 hx200 hxnot hsid
  have h := certs_ok ⟨x - 1, by omega⟩
  have hsub : x - 1 + 1 = x := Nat.sub_add_cancel hx1
  dsimp only at h
  rw [hsub] at h
  rcases h with hmem | ⟨ha, hb, hc, hd, hab, hcd, hsum, hneq⟩
  · exact hxnot hmem
  · exact hneq (hsid _ ha _ hb _ hc _ hd hab hcd hsum)

end Erdos.Claims.E_rec_200_s10
